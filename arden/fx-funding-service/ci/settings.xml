<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <servers>
    <server>
      <id>ardencm-artifactory</id>
      <username>svc-fx-funding-service</username>
      <!-- Injected by ci-shared-workflows java-build@v4 (short-lived token via GitHub OIDC exchange). Never commit a literal. -->
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>ardencm-artifactory</id>
      <mirrorOf>*</mirrorOf>
      <url>https://artifactory.ardencm.internal/artifactory/maven-remote</url>
    </mirror>
  </mirrors>
</settings>
