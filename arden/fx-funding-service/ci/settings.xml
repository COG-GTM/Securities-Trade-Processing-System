<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <servers>
    <server>
      <id>ardencm-artifactory</id>
      <username>svc-fx-funding-service</username>
      <!-- Short-lived token from ci-shared-workflows@v4 (GitHub OIDC exchange), exported as ARTIFACTORY_TOKEN. Never commit a token here. -->
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>ardencm-artifactory</id>
      <mirrorOf>*</mirrorOf>
      <url>https://artifactory.ardencm.internal/artifactory/maven-remote</url>
    </mirror>
  </mirrors>
</settings>
